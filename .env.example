# Central de WhatsApp (Meta Cloud API)
# Obtidos em developers.facebook.com > seu App > WhatsApp > API Setup / Configuration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Id da conta comercial (WABA), em WhatsApp Manager > Configurações da conta.
# Não é o mesmo que o PHONE_NUMBER_ID.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Aviso de andamento de tarefa fora da janela de 24h. Crie o template no
# WhatsApp Manager na categoria UTILITY, com {{1}} = título e {{2}} = situação,
# e ponha aqui o nome dele depois de aprovado. Vazio = nenhum aviso fora da janela.
WHATSAPP_TEMPLATE_ANDAMENTO_TAREFA=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR

# Conformidade Legal — Claude no Microsoft Foundry
CONFORMIDADE_IA_FOUNDRY_RESOURCE=grupodb-conformidade-resource
CONFORMIDADE_IA_FOUNDRY_KEY=
CONFORMIDADE_IA_MODELO=claude-opus-5-5

# Conformidade Legal — Diário Oficial da União pelo INLABS (inlabs.in.gov.br)
CONFORMIDADE_INLABS_EMAIL=
CONFORMIDADE_INLABS_SENHA=
